{
  "file_format_version": "1.0.0",
  "layer": {
    "name": "@LAYER_NAME@",
    "type": "GLOBAL",
    "api_version": "1.3.0",
    "library_path": "@LIBRARY_PATH@",
    "implementation_version": "1",
    "description": "frame-pacer Vulkan limiter and performance HUD",
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": {
      "ENABLE_FRAME_PACER": "1"
    },
    "disable_environment": {
      "DISABLE_FRAME_PACER": "1"
    }
  }
}
